---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
}

const { title, subtitle, badge } = Astro.props;
---
<div class="flex items-center justify-between mb-4">
  <div class="flex items-center gap-3">
    <h2 class="text-sm font-semibold text-text-primary tracking-tight">{title}</h2>
    {badge && (
      <span class="text-[10px] font-medium text-text-tertiary bg-bg-tertiary px-2 py-0.5 rounded-full border border-border-primary uppercase tracking-wider">
        {badge}
      </span>
    )}
  </div>
  {subtitle && <span class="text-xs text-text-tertiary font-mono">{subtitle}</span>}
</div>
