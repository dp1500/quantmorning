---
import type { AsianMarketQuote, MarketSnapshot } from '../../lib/types';
import { formatPrice, formatPct, pnlColor, vixRegimeInfo } from '../../lib/formatters';
import SectionHeader from '../ui/SectionHeader.astro';
import QuickCard from '../ui/QuickCard.astro';

const data: MarketSnapshot = await import('../../data/market_snapshot.json').then(m => m.default);
const { nifty50, sensex, india_vix, brentOil, gold, usdInr, dxy } = data.assets;
const giftNifty = data.giftNifty;
const asianMarkets = data.asianMarkets || [];
const vixRegime = data.vixRegime || 'normal';
const vixInfo = vixRegimeInfo(vixRegime);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 pt-6">
  <SectionHeader
    title="Market Snapshot"
    subtitle={data.timestamp ? new Date(data.timestamp).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' }) : ''}
    badge="Live"
  />

  <!-- ROW 1: Nifty 50 + SENSEX + GIFT Nifty/VIX -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-3">
    <!-- NIFTY 50 -->
    {nifty50 && (
      <div class="bg-bg-card border border-border-primary rounded-xl p-4 hover:bg-bg-card-hover transition-colors">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            <span class="text-xs font-semibold text-text-primary tracking-tight">NIFTY 50</span>
          </div>
          <span class={`text-xs font-semibold ${pnlColor(nifty50.changePct)}`}>
            {formatPct(nifty50.changePct)}
          </span>
        </div>
        <div class="flex items-baseline gap-2 mb-2">
          <span class="text-2xl font-bold tracking-tight text-text-primary">{formatPrice(nifty50.ltp)}</span>
          <span class={`text-xs font-mono font-semibold ${pnlColor(nifty50.change)}`}>
            {nifty50.change >= 0 ? '+' : ''}{formatPrice(nifty50.change)}
          </span>
        </div>
        <div class="flex items-center justify-between text-[10px]">
          <div class="flex flex-col">
            <span class="text-text-disabled uppercase tracking-wider">Prev Close</span>
            <span class="font-mono text-text-secondary">{formatPrice(nifty50.prevClose)}</span>
          </div>
          <div class="flex flex-col items-end">
            <span class="text-text-disabled uppercase tracking-wider">Yesterday Range</span>
            <span class="font-mono text-text-secondary">L {formatPrice(nifty50.dayLow)} — H {formatPrice(nifty50.dayHigh)}</span>
          </div>
        </div>
        {nifty50.prevHigh && nifty50.prevLow && nifty50.prevRangePct != null && (
          <div class="mt-3 pt-3 border-t border-border-subtle">
            <div class="flex items-center justify-between text-[10px] mb-1">
              <span class="text-text-disabled uppercase tracking-wider">Range</span>
              <span class="font-mono text-text-tertiary">{nifty50.prevRangePct.toFixed(1)}%</span>
            </div>
            <div class="relative h-1 bg-bg-tertiary rounded-full overflow-hidden">
              <div class="absolute inset-y-0 bg-accent/30 rounded-full" style="left: 0%; right: 0%"></div>
            </div>
            <div class="flex justify-between text-[10px] font-mono text-text-tertiary mt-0.5">
              <span>L {formatPrice(nifty50.prevLow)}</span>
              <span>H {formatPrice(nifty50.prevHigh)}</span>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- SENSEX -->
    {sensex && (
      <div class="bg-bg-card border border-border-primary rounded-xl p-4 hover:bg-bg-card-hover transition-colors">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            <span class="text-xs font-semibold text-text-primary tracking-tight">SENSEX</span>
          </div>
          <span class={`text-xs font-semibold ${pnlColor(sensex.changePct)}`}>
            {formatPct(sensex.changePct)}
          </span>
        </div>
        <div class="flex items-baseline gap-2 mb-2">
          <span class="text-2xl font-bold tracking-tight text-text-primary">{formatPrice(sensex.ltp)}</span>
          <span class={`text-xs font-mono font-semibold ${pnlColor(sensex.change)}`}>
            {sensex.change >= 0 ? '+' : ''}{formatPrice(sensex.change)}
          </span>
        </div>
        <div class="flex items-center justify-between text-[10px]">
          <div class="flex flex-col">
            <span class="text-text-disabled uppercase tracking-wider">Prev Close</span>
            <span class="font-mono text-text-secondary">{formatPrice(sensex.prevClose)}</span>
          </div>
          <div class="flex flex-col items-end">
            <span class="text-text-disabled uppercase tracking-wider">Day Range</span>
            <span class="font-mono text-text-secondary">L {formatPrice(sensex.dayLow)} — H {formatPrice(sensex.dayHigh)}</span>
          </div>
        </div>
        {sensex.prevHigh && sensex.prevLow && sensex.prevRangePct != null && (
          <div class="mt-3 pt-3 border-t border-border-subtle">
            <div class="flex items-center justify-between text-[10px] mb-1">
              <span class="text-text-disabled uppercase tracking-wider">Prev Day Range</span>
              <span class="font-mono text-text-tertiary">{sensex.prevRangePct.toFixed(1)}%</span>
            </div>
            <div class="relative h-1 bg-bg-tertiary rounded-full overflow-hidden">
              <div class="absolute inset-y-0 bg-blue-400/30 rounded-full" style="left: 0%; right: 0%"></div>
            </div>
            <div class="flex justify-between text-[10px] font-mono text-text-tertiary mt-0.5">
              <span>L {formatPrice(sensex.prevLow)}</span>
              <span>H {formatPrice(sensex.prevHigh)}</span>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- GIFT Nifty + VIX -->
    <div class="bg-bg-card border border-border-primary rounded-xl p-4">
      <div class="mb-3 pb-3 border-b border-border-subtle">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-text-primary tracking-tight">GIFT Nifty</span>
          <span class={`text-xs font-semibold ${pnlColor(giftNifty.changePct)}`}>
            {formatPct(giftNifty.changePct)}
          </span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-xl font-bold tracking-tight text-text-primary">
            {giftNifty.ltp > 0 ? formatPrice(giftNifty.ltp) : '—'}
          </span>
          {giftNifty.ltp > 0 && nifty50 && (
            <span class={`text-xs font-mono font-semibold ${pnlColor(giftNifty.ltp - nifty50.ltp)}`}>
              Gap {giftNifty.ltp - nifty50.ltp >= 0 ? '+' : ''}{formatPrice(Math.abs(giftNifty.ltp - nifty50.ltp))} pts
            </span>
          )}
        </div>
      </div>
      {india_vix && (
        <div>
          <div class="flex items-center justify-between mb-1">
            <span class="text-[10px] font-semibold text-text-tertiary uppercase tracking-wider">India VIX</span>
            <span class={`text-[10px] font-semibold uppercase ${vixInfo.color}`}>{vixInfo.label}</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-lg font-bold text-text-primary">{india_vix.ltp.toFixed(1)}</span>
            <span class={`text-xs font-mono font-semibold ${pnlColor(india_vix.changePct)}`}>
              {formatPct(india_vix.changePct)}
            </span>
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- ROW 2: Commodities + Asian Markets -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3">
    {gold && <QuickCard label="Gold" ltp={gold.ltp} changePct={gold.changePct} change={gold.change} precision={0} sparkline={gold.sparkline} />}
    {brentOil && <QuickCard label="Brent Crude" ltp={brentOil.ltp} changePct={brentOil.changePct} change={brentOil.change} precision={2} sparkline={brentOil.sparkline} />}
    {usdInr && <QuickCard label="USD/INR" ltp={usdInr.ltp} changePct={usdInr.changePct} change={usdInr.change} precision={2} sparkline={usdInr.sparkline} />}
    {dxy && <QuickCard label="DXY" ltp={dxy.ltp} changePct={dxy.changePct} change={dxy.change} precision={2} sparkline={dxy.sparkline} />}
    {asianMarkets.slice(0, 3).map((m: AsianMarketQuote) => {
      const flagIcon = m.name === 'Nikkei 225' ? '🇯🇵' : m.name === 'KOSPI' ? '🇰🇷' : '🇭🇰';
      return <QuickCard label={m.name} ltp={m.ltp} changePct={m.changePct} change={m.change} precision={0} sparkline={m.sparkline} flag={flagIcon} />;
    })}
  </div>
</section>
